#!/usr/bin/env python3
"""Fails when an implementation file reaches 1000 lines.

Declaration-only files (headers, and files listed in DECLARATION_FILES) may be longer.
"""

from __future__ import annotations

import sys
from pathlib import Path

LIMIT = 1000
SOURCE_SUFFIXES = {".swift", ".m", ".c"}
DECLARATION_FILES: set[str] = set()


def main() -> int:
    root = Path(__file__).resolve().parent.parent
    failures = []
    for path in sorted((root / "Sources").rglob("*")):
        relative = path.relative_to(root).as_posix()
        if path.suffix not in SOURCE_SUFFIXES or relative in DECLARATION_FILES:
            continue
        lines = len(path.read_text(encoding="utf-8").splitlines())
        if lines >= LIMIT:
            failures.append(f"{relative}: {lines} lines (limit {LIMIT})")
    for failure in failures:
        print(failure)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
