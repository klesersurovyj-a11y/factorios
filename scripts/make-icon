#!/usr/bin/env python3
"""Draws Resources/AppIcon.png: an orange gear on a dark ground, 1024x1024, no dependencies."""

from __future__ import annotations

import math
import struct
import zlib
from pathlib import Path

SIZE = 1024
BACKGROUND = (28, 30, 34)
GEAR = (232, 138, 46)
HOLE = (28, 30, 34)
TEETH = 10
OUTER, INNER, HUB = 400, 320, 130
SAMPLES = 4  # per axis, for anti-aliasing


def gear_radius(angle: float) -> float:
    """Outer edge of the gear at this angle: flat-topped teeth with sloped flanks."""
    phase = (angle * TEETH / (2 * math.pi)) % 1.0
    distance = abs(phase - 0.5) * 2  # 0 at a tooth's centre, 1 between teeth
    blend = min(max((distance - 0.35) / 0.25, 0.0), 1.0)
    return OUTER + (INNER - OUTER) * blend


def coverage(x: float, y: float) -> float:
    dx, dy = x - SIZE / 2, y - SIZE / 2
    radius = math.hypot(dx, dy)
    return 1.0 if HUB < radius < gear_radius(math.atan2(dy, dx)) else 0.0


def pixel(px: int, py: int) -> bytes:
    step = 1 / SAMPLES
    hits = sum(
        coverage(px + (sx + 0.5) * step, py + (sy + 0.5) * step) for sx in range(SAMPLES) for sy in range(SAMPLES)
    )
    alpha = hits / SAMPLES**2
    base = HOLE if math.hypot(px - SIZE / 2, py - SIZE / 2) <= HUB else BACKGROUND
    return bytes(round(g * alpha + b * (1 - alpha)) for g, b in zip(GEAR, base, strict=True))


def chunk(kind: bytes, data: bytes) -> bytes:
    return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))


def main() -> None:
    rows = b"".join(b"\0" + b"".join(pixel(x, y) for x in range(SIZE)) for y in range(SIZE))
    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", SIZE, SIZE, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(rows, 9)) + chunk(b"IEND", b"")
    out = Path(__file__).resolve().parent.parent / "Resources" / "AppIcon.png"
    out.write_bytes(png)
    print(f"wrote {out}")


if __name__ == "__main__":
    main()
