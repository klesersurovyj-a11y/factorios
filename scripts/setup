#!/usr/bin/env python3
"""Finds this Mac's device, signing team and Factorio disk image and writes them to mise.local.toml.

usage: mise run setup [-- --device UDID] [--team TEAM_ID] [--dmg PATH] [--bundle-id ID]

A value given as a flag wins. Otherwise a value already in mise.local.toml is kept while it is still valid, and a
missing one is detected when there is exactly one candidate.
"""

from __future__ import annotations

import argparse
import json
import os
import plistlib
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LOCAL = ROOT / "mise.local.toml"
DMG_PATTERN = "factorio*mac*.dmg"


def fail(message: str) -> None:
    sys.exit(f"setup: {message}")


def run(*args: str) -> str:
    return subprocess.run(args, check=True, capture_output=True, text=True).stdout


def pick(kind: str, flag: str, current: str | None, candidates: dict[str, str], hint: str) -> str:
    """Keeps `current` if it is still a candidate, else takes the only candidate; `candidates` maps value to label."""
    if current in candidates:
        return current
    if len(candidates) == 1:
        return next(iter(candidates))
    if not candidates:
        fail(f"no {kind} found: {hint}")
    listing = "\n".join(f"  {value}  {label}" for value, label in candidates.items())
    fail(f"several {kind}s found; choose one with {flag}:\n{listing}")
    raise AssertionError


def check_xcode() -> None:
    try:
        developer = run("xcode-select", "--print-path").strip()
        run("xcrun", "--sdk", "iphoneos", "--show-sdk-path")
    except (OSError, subprocess.CalledProcessError):
        fail("install Xcode from the App Store, open it once, then run `sudo xcode-select -s /Applications/Xcode.app`")
    if "CommandLineTools" in developer:
        fail("Command Line Tools are selected; run `sudo xcode-select -s /Applications/Xcode.app`")


def detect_devices() -> dict[str, str]:
    with tempfile.TemporaryDirectory() as directory:
        output = Path(directory) / "devices.json"
        run("xcrun", "devicectl", "list", "devices", "--quiet", "--json-output", str(output))
        devices = json.loads(output.read_text())["result"]["devices"]
    found = {}
    for device in devices:
        hardware, properties = device["hardwareProperties"], device["deviceProperties"]
        if hardware.get("reality") != "physical" or hardware.get("platform") != "iOS":
            continue
        label = f"{properties.get('name')} ({hardware.get('marketingName')})"
        if properties.get("developerModeStatus") != "enabled":
            label += ", Developer Mode off"
        found[hardware["udid"]] = label
    return found


def detect_teams() -> dict[str, str]:
    defaults = plistlib.loads(run("defaults", "export", "com.apple.dt.Xcode", "-").encode())
    found = {}
    for teams in defaults.get("IDEProvisioningTeamByIdentifier", {}).values():
        for team in teams:
            found[team["teamID"]] = f"{team.get('teamName')} ({team.get('teamType')})"
    return found


def detect_dmgs() -> dict[str, str]:
    places = [ROOT / "artifact", Path.home() / "Downloads"]
    images = sorted((p for place in places if place.is_dir() for p in place.glob(DMG_PATTERN)), key=os.path.getmtime)
    # The newest download is the one to use; older ones are left over from earlier versions.
    return {str(images[-1]): "newest download"} if images else {}


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--device", help="the iPhone's or iPad's UDID (xcrun devicectl list devices)")
    parser.add_argument("--team", help="the Apple development team ID (Xcode > Settings > Accounts)")
    parser.add_argument("--dmg", help="Factorio for macOS disk image from factorio.com")
    parser.add_argument("--bundle-id", help="the app's bundle ID; must be unique to your team")
    args = parser.parse_args()

    check_xcode()
    device = args.device or pick(
        "device", "--device", os.environ.get("FACTORIOS_DEVICE_ID"), detect_devices(),
        "connect the iPhone or iPad with a cable, unlock it and trust this Mac",
    )
    team = args.team or pick(
        "team", "--team", os.environ.get("FACTORIOS_TEAM_ID"), detect_teams(),
        "add your Apple Account in Xcode > Settings > Accounts",
    )
    current_dmg = os.environ.get("FACTORIOS_DMG")
    dmg = args.dmg or (current_dmg if current_dmg and Path(current_dmg).is_file() else None)
    dmg = dmg or pick(
        "Factorio disk image", "--dmg", None, detect_dmgs(),
        "download Factorio for macOS from https://factorio.com/download to ~/Downloads, or pass --dmg",
    )
    if not Path(dmg).is_file():
        fail(f"{dmg} does not exist")
    # A free team's App IDs are unique across Apple, so each team needs its own.
    bundle_id = args.bundle_id or os.environ.get("FACTORIOS_BUNDLE_ID") or f"app.factorios.{team.lower()}"
    if not re.fullmatch(r"[A-Za-z0-9.-]+", bundle_id):
        fail(f"{bundle_id} is not a valid bundle ID")

    values = {
        "FACTORIOS_DEVICE_ID": device,
        "FACTORIOS_TEAM_ID": team,
        "FACTORIOS_DMG": str(Path(dmg).resolve()),
        "FACTORIOS_BUNDLE_ID": bundle_id,
    }
    subprocess.run(["mise", "set", "--file", str(LOCAL), *(f"{k}={v}" for k, v in values.items())], check=True)
    for key, value in values.items():
        print(f"{key} = {value}")
    print(f"wrote {LOCAL.name}; next: mise run deploy")


if __name__ == "__main__":
    main()
